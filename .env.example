# ========================================================
# ANTIGRAVITY HISTORY BOT - 100% FREE CONFIGURATION
# ========================================================

# 1. OPTION A: Google AI Studio Gemini API (100% Free - 0$ Cost)
# Get a free API key at: https://aistudio.google.com/
# (15 requests/min completely free, no credit card required)
GEMINI_API_KEY=

# 2. OPTION B: Groq API (100% Free Alternative - 0$ Cost)
# Get a free key at: https://console.groq.com/
# (Gives free Llama 3.3 70B with ultra-fast generation, no credit card)
GROQ_API_KEY=

# NOTE: If you leave BOTH blank, the bot automatically uses its built-in
# 100% OFFLINE LOCAL NARRATIVE ENGINE. No APIs, no tokens, no money spent!

# 3. YouTube OAuth 2.0 Credentials (Optional)
# Download your client_secret.json from Google Cloud Console
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
